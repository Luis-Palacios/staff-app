# Base URL for the applications-membership backend API (server-side only, no NEXT_PUBLIC_ prefix).
# Local dev: point at your locally running backend.
# Deployment: set this in the container/orchestration environment — no rebuild required.
APPLICATIONS_MEMBERSHIP_API_URL=http://localhost:8000

# Base URL for the auth-server (better-auth) instance. NEXT_PUBLIC_ prefixed and required because
# Phase 2 of docs/AUTH-INTEGRATION-ROADMAP.md calls it directly from browser-side code (the
# better-auth React client) — Next.js only inlines env vars into the browser bundle when they
# carry this prefix. Phase 3 replaces this cross-origin browser call with a same-origin proxy
# (next.config.mjs's rewrites() reads this same var server-side as the proxy destination) — the
# browser stops needing it directly at that point, but it stays as-is rather than being replaced
# by a separate server-only var (Next.js can read a NEXT_PUBLIC_ var from server-side code too).
NEXT_PUBLIC_AUTH_SERVER_URL=http://localhost:5000
