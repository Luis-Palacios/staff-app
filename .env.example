# Base URL for the applications-membership backend API (server-side only, no NEXT_PUBLIC_ prefix).
# Local dev: point at your locally running backend.
# Deployment: set this in the container/orchestration environment — no rebuild required.
APPLICATIONS_MEMBERSHIP_API_URL=http://localhost:8000

# Base URL for the auth-server (better-auth) instance, reachable from staff-app's own server.
# Server-only (no NEXT_PUBLIC_ prefix) — since Phase 3 of docs/AUTH-INTEGRATION-ROADMAP.md, the
# browser never calls auth-server directly; next.config.mjs proxies /api/auth/* here instead, so
# the browser only ever talks to staff-app's own origin. Same value as local dev; diverges once
# these are separate Docker containers on an internal network.
AUTH_SERVER_INTERNAL_URL=http://localhost:5000
