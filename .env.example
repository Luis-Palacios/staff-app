# Base URL for the applications-membership backend API (server-side only, no NEXT_PUBLIC_ prefix).
# Local dev: point at your locally running backend.
# Deployment: set this in the container/orchestration environment — no rebuild required.
APPLICATIONS_MEMBERSHIP_API_URL=http://localhost:8000

# Base URL for the auth-server (better-auth) instance (server-side only, no NEXT_PUBLIC_ prefix).
# Used by proxy.ts to forward the browser's /api/auth/* calls, and by server-side session/token
# calls. The browser never uses it: the better-auth client calls same-origin /api/auth.
# Deployment: set this in the container/orchestration environment — no rebuild required.
AUTH_SERVER_URL=http://localhost:5000