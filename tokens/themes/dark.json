  },
  "marker-ring": {
    "$type": "color",
    "$value": "rgb(242 181 68 / 0.22)",
    "$description": "gold-500 at 22%"
  },
  "overlay-border": {
    "$type": "color",
    "$value": "{color.field-line-on-dark}",
    "$description": "= --field-border: --border vanishes on navy-800"
  },
  "overlay-menu-shadow": {
    "$type": "shadow",
    "$value": "0 12px 32px rgb(0 0 0 / 0.45)"
  }
