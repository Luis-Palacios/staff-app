{
  "$description": "Semantic tokens, dark theme. Names are the CSS variables HeroUI v3 reads (plus our custom ones). Built into styles/theme.css.",
  "background": {
    "$type": "color",
    "$value": "{color.navy-950}",
    "$description": "navy-950"
  },
  "foreground": {
    "$type": "color",
    "$value": "{color.on-dark}",
    "$description": "on-dark"
  },
  "surface": {
    "$type": "color",
    "$value": "{color.navy-900}",
    "$description": "navy-900"
  },
  "surface-secondary": {
    "$type": "color",
    "$value": "{color.navy-800}",
    "$description": "navy-800"
  },
  "surface-tertiary": {
    "$type": "color",
    "$value": "{color.navy-700}"
  },
  "overlay": {
    "$type": "color",
    "$value": "{color.navy-800}"
  },
  "muted": {
    "$type": "color",
    "$value": "{color.muted-on-dark}"
  },
  "default": {
    "$type": "color",
    "$value": "{color.navy-800}"
  },
  "default-foreground": {
    "$type": "color",
    "$value": "{color.heading-on-dark}"
