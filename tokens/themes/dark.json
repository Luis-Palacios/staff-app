    "$type": "color",
    "$value": "{color.gold-500}"
  },
  "warning-foreground": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "danger": {
    "$type": "color",
    "$value": "{color.danger-on-dark}"
