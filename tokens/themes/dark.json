  },
  "accent-soft": {
    "$type": "color",
    "$value": "{color.navy-800}"
  },
  "accent-soft-foreground": {
    "$type": "color",
    "$value": "{color.gold-300}"
  },
  "heading": {
    "$type": "color",
    "$value": "{color.heading-on-dark}"
  },
  "eyebrow": {
    "$type": "color",
    "$value": "{color.gold-500}"
  },
  "subtle": {
    "$type": "color",
    "$value": "#5E7391"
