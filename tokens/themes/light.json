{
  "$description": "Semantic tokens, light theme. Names are the CSS variables HeroUI v3 reads (plus our custom ones). Built into styles/theme.css.",
  "container-lg": {
    "$type": "dimension",
    "$value": "80rem"
  },
  "background": {
    "$type": "color",
    "$value": "{color.paper}",
    "$description": "paper"
  },
  "foreground": {
    "$type": "color",
    "$value": "{color.ink}",
    "$description": "ink: body text"
  },
  "surface": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "surface-secondary": {
    "$type": "color",
    "$value": "{color.navy-50}",
    "$description": "navy-50"
  },
  "surface-tertiary": {
    "$type": "color",
    "$value": "{color.navy-100}",
    "$description": "navy-100"
  },
  "overlay": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "muted": {
    "$type": "color",
    "$value": "{color.ink-muted}"
  },
  "default": {
    "$type": "color",
    "$value": "{color.navy-50}"
  },
  "default-foreground": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "accent": {
    "$type": "color",
    "$value": "{color.navy-900}",
    "$description": "navy: primary buttons, selection"
  },
  "accent-foreground": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "focus": {
    "$type": "color",
    "$value": "{color.gold-800}",
    "$description": "gold-800: plain gold-500 is ~1.7:1 on paper, fails WCAG 1.4.11"
  },
  "shadow-focus": {
    "$type": "shadow",
    "$value": "0 0 0 2px var(--background), 0 0 0 4px var(--focus)"
  },
  "focus-row": {
    "$type": "color",
    "$value": "{color.gold-50}",
    "$description": "tint of the table row whose conversation panel is open (with a 3px gold-500 inset edge)"
  },
  "link": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "border": {
    "$type": "color",
    "$value": "{color.line}"
  },
  "separator": {
    "$type": "color",
    "$value": "{color.line-subtle}"
  },
  "field-background": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "field-foreground": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "field-border": {
    "$type": "color",
    "$value": "{color.field-line}"
  },
  "field-border-width": {
    "$type": "dimension",
    "$value": "1px"
  },
  "field-placeholder": {
    "$type": "color",
    "$value": "{color.ink-muted}"
  },
  "success": {
    "$type": "color",
    "$value": "{color.success-700}"
  },
  "success-foreground": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "warning": {
    "$type": "color",
    "$value": "{color.gold-500}"
  },
  "warning-foreground": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "danger": {
    "$type": "color",
    "$value": "{color.danger-700}"
  },
  "danger-foreground": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "success-soft": {
    "$type": "color",
    "$value": "{color.success-50}",
    "$description": "soft (badge) pairs: set explicitly, HeroUI's color-mix derivations fail contrast"
  },
  "success-soft-foreground": {
    "$type": "color",
    "$value": "{color.success-800}"
  },
  "warning-soft": {
    "$type": "color",
    "$value": "{color.gold-100}",
    "$description": "gold-100"
  },
  "warning-soft-foreground": {
    "$type": "color",
    "$value": "{color.gold-900}",
    "$description": "gold-900"
  },
  "danger-soft": {
    "$type": "color",
    "$value": "{color.danger-50}"
  },
  "danger-soft-foreground": {
    "$type": "color",
    "$value": "{color.danger-700}"
  },
  "accent-soft": {
    "$type": "color",
    "$value": "{color.navy-100}"
  },
  "accent-soft-foreground": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "heading": {
    "$type": "color",
    "$value": "{color.navy-900}",
    "$description": "custom: page/card titles"
  },
  "eyebrow": {
    "$type": "color",
    "$value": "{color.gold-800}",
    "$description": "custom: gold-800 eyebrow text"
  },
  "subtle": {
    "$type": "color",
    "$value": "{color.ink-faint}",
    "$description": "custom: decorative only (chevrons, hollow dots), not text"
  },
  "rail": {
    "$type": "color",
    "$value": "{color.navy-900}",
    "$description": "custom: sidebar, same in both modes"
  },
  "rail-edge": {
    "$type": "color",
    "$value": "{color.navy-900}"
  },
  "segment": {
    "$type": "color",
    "$value": "{color.navy-50}",
    "$description": "custom: segmented controls (theme switch). Track and selected pill swap surfaces between modes, so they need their own tokens."
  },
  "segment-selected": {
    "$type": "color",
    "$value": "{color.white}"
  },
  "segment-shadow": {
    "$type": "shadow",
    "$value": "0 1px 2px rgb(11 35 65 / 0.12)"
  },
  "segment-icon-selected": {
    "$type": "color",
    "$value": "{color.gold-800}",
    "$description": "gold-800 outline around the gold fill: gold-500 alone is ~1.7:1 on white"
  },
  "marker-ring": {
    "$type": "color",
    "$value": "{color.gold-100}",
    "$description": "custom: halo around the gold \"current\" timeline marker gold-100"
  },
  "overlay-border": {
    "$type": "color",
    "$value": "{color.line}",
    "$description": "custom: menus that sit on the page (church menu). HeroUI popovers have no border, and its --overlay-shadow is shared with modals, selects, tooltips and toasts, so these are scoped to the menus that use them. = --border"
  },
  "overlay-menu-shadow": {
    "$type": "shadow",
    "$value": "0 12px 32px rgb(11 35 65 / 0.16), 0 2px 6px rgb(11 35 65 / 0.08)"
  },
  "radius": {
    "$type": "dimension",
    "$value": "0.625rem",
    "$description": "10px controls"
  },
  "field-radius": {
    "$type": "dimension",
    "$value": "0.625rem"
  }
}
